{
  // bot.usefulbuild.com: the Useful Bot landing and privacy pages. Static
  // assets only, the same setup as voice. and brain.usefulbuild.com.
  // Deploy: npx wrangler deploy --config site/wrangler.jsonc
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "useful-bot-site",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bot.usefulbuild.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
