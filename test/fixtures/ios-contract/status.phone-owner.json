{
  "note": "requireOwner over the phone session: apiVersion + eve probe.",
  "request": {
    "method": "GET",
    "path": "/api/status",
    "headers": {
      "tailscale-user-login": "owner@tailnet.example",
      "x-forwarded-for": "100.64.1.2",
      "x-forwarded-proto": "https",
      "cookie": "<sessionCookie>"
    }
  },
  "response": {
    "status": 200,
    "setCookie": false,
    "json": {
      "ok": true,
      "apiVersion": 1,
      "profile": "phone",
      "eve": "available",
      "operator": {
        "name": "Devin",
        "initials": "DE"
      },
      "version": "0.0.0",
      "theme": "light"
    }
  }
}
