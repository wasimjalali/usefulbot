{
  "note": "Sign-out: cookie + CSRF, the session row is destroyed.",
  "request": {
    "method": "DELETE",
    "path": "/api/auth/session",
    "headers": {
      "tailscale-user-login": "owner@tailnet.example",
      "x-forwarded-for": "100.64.1.2",
      "x-forwarded-proto": "https",
      "cookie": "<sessionCookie>",
      "x-ub-csrf": "<csrfToken>"
    }
  },
  "response": {
    "status": 200,
    "setCookie": true,
    "json": {
      "ok": true
    }
  }
}
