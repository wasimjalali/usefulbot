+            repeat { start -= 1 } while start > full.hidden && !transcriptBlocks[start].isMessage
+            firstPaintStep = transcriptBlocks[start].id
+            republishWindow()
+            try? await Task.sleep(nanoseconds: 16_000_000)
+        }
+        guard run == firstPaintRun else { return }
