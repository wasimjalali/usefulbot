        .onChange(of: focus) { _, next in
            if next == nil {
                commitName(bot)
                commitLabel(bot)
                commitDescription(bot)
            }
        }
        .onDisappear {
            commitName(bot)
            commitLabel(bot)
            commitDescription(bot)
        }
    }

