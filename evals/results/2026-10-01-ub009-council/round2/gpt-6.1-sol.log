   493	let sharedStore: MemoryStore | null = null;
   494	let sharedRoot = "";
   495	
   496	/**
   497	 * One store per process and root for the memory tools. Each tool call used
   498	 * to open its own SQLite handle that only GC released; sharing one instance
   499	 * keeps the handles bounded. Keyed by the resolved root so a changed
   500	 * UB_MEMORY_ROOT (tests use one per case) does not keep the old directory.
   501	 * Tests and the web route keep using the constructor.
   502	 */
   503	export function sharedMemoryStore(): MemoryStore {
   504	  const root = memoryRoot();
   505	  if (!sharedStore || sharedRoot !== root) {
   506	    sharedStore?.close();
   507	    sharedStore = new MemoryStore(root);
   508	    sharedRoot = root;
   509	  }
   510	  return sharedStore;
   511	}
