   344	    `(deny file-write* (regex #"${APP_STATE_DASHED_PATTERN}"))`,
   345	    `(deny file-write* (regex #"${RUNTIME_INSTALL_PATTERN}"))`,
   346	    `(deny file-write* (regex #"${SECRETS_DENY_PATTERN}"))`,
   347	  ];
   348	  // Inside a project folder the build tooling reads its own .env and the
   349	  // like. Scoped, that is the whole of what the line can reach anyway;
   350	  // unbounded, the deny stays on for the rest of the disk and only the
   351	  // folder's own copies are allowed back (a later rule wins).
   352	  const tooling = root !== null && scope === "folder";
   353	  const readDenied = tooling && !unbounded
   354	    ? READ_DENIED_NAMES.filter((name) => !TOOLING_READS.has(name))
   355	    : READ_DENIED_NAMES;
   356	  const readRules = [
   357	    ...readDenied.map((name) => `(deny file-read* (regex #"/${regexEscape(name)}($|[/.])"))`),
   358	    `(deny file-read* (regex #"${APP_STATE_DASHED_PATTERN}"))`,
   359	    `(deny file-read* (regex #"${RUNTIME_INSTALL_PATTERN}"))`,
   360	    `(deny file-read* (regex #"${SECRETS_DENY_PATTERN}"))`,
   361	    `(allow file-read* (regex #"${SECRETS_ALLOW_PATTERN}"))`,
   362	    ...(tooling && unbounded && real !== null
   363	      ? [...TOOLING_READS].map((name) => `(allow file-read* (regex #"^${regexEscape(real)}(/.*)?/${regexEscape(name)}($|[/.])"))`)
