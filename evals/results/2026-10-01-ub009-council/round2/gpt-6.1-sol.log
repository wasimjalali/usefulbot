   207	/** Locked read-modify-write; the web server and the agent both write. */
   208	export function updateWorkspaceStore(
   209	  mutate: (store: WorkspaceStore) => WorkspaceStore,
   210	  path = defaultWorkspacePath(),
   211	): WorkspaceStore {
   212	  const lock = `${path}.lock`;
   213	  mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
   214	  const deadline = Date.now() + LOCK_TIMEOUT_MS;
   215	  let held = false;
   216	  while (!held) {
   217	    try {
   218	      mkdirSync(lock, { mode: 0o700 });
   219	      held = true;
   220	    } catch {
   221	      try {
   222	        if (Date.now() - statSync(lock).mtimeMs > LOCK_STALE_MS) rmdirSync(lock);
   223	      } catch { /* lock vanished; retry */ }
   224	      if (Date.now() > deadline) break;
   225	      sleep(15);
   226	    }
   227	  }
   228	  if (!held) throw new Error("workspace_locked");
   229	  try {
   230	    // Writes must not clobber what they could not read. If the store on disk
   231	    // is corrupt, back it up first and start from the seed, the way the
   232	    // shell store does; a silent overwrite loses the evidence.
   233	    let previous = peekStoreFile(path);
   234	    if (previous === null && existsSync(path)) {
   235	      const bak = `${path}.invalid.${process.pid}.${Date.now()}`;
