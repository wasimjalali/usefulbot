    24	    UNTRUSTED_PREAMBLE,
    25	    `BEGIN-UNTRUSTED(${oneLine(source)})`,
    26	    fence,
    27	    text,
    28	    fence,
    29	    "END-UNTRUSTED",
    30	  ].join("\n");
    31	}
