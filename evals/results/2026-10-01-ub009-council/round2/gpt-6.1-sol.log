    44	        return { status: "not_found", error: "no bot to clear", hint: "Call list_bots for exact ids." };
    45	      }
    46	      // An id is exact; a name is not. Two bots may share a name up to case,
    47	      // and this erases messages, so an ambiguous match asks rather than picks.
