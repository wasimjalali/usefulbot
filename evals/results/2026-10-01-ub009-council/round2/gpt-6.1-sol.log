  1091	async function executeRoutine(
  1092	  routine: Routine,
  1093	  trigger: "schedule" | "manual",
  1094	): Promise<RoutineRunResult> {
  1095	  const shell = readShell();
  1096	  const bot = shell.bots.find((item) => item.id === routine.botId);
  1097	  if (!bot) throw new Error("routine_bot_missing");
  1098	  if (bot.hidden) throw new Error("routine_bot_hidden");
  1099	  const threadKind: ThreadKind = bot.kind === "group" ? "group" : "bot";
  1100	  // These two go in before the turn so the live stream echo pairs with the
  1101	  // durable row rather than rendering a second bubble. If the agent store
  1102	  // itself will not open, there is no transcript to leave hanging and no point
  1103	  // spending an eve turn nobody will see, so that fails the run outright.
  1104	  try {
  1105	    // The note keeps the transcript honest: without it a scheduled turn reads
  1106	    // as something the owner typed.
  1107	    appendAgentEvent(bot.id, {
  1108	      kind: "note",
  1109	      threadKind,
  1110	      text: trigger === "manual"
  1111	        ? `Test run of routine "${routine.name}".`
  1112	        : `Routine "${routine.name}" ran.`,
  1113	    });
  1114	    // The instruction is stored verbatim; the bot's identity prefix is added
  1115	    // on the way to eve (see runEveTurn).
  1116	    appendAgentEvent(bot.id, {
  1117	      kind: "user",
  1118	      threadKind,
  1119	      sessionId: bot.sessionId ?? "",
  1120	      text: routine.instruction,
  1121	    });
  1122	  } catch (err) {
  1123	    // The note can land and the instruction fail, which leaves the same
  1124	    // dangling row this whole path exists to avoid. Say so where it shows.
  1125	    try {
  1126	      appendAgentEvent(bot.id, {
  1127	        kind: "note",
  1128	        threadKind,
  1129	        text: `Routine "${routine.name}" could not start: the transcript was unavailable.`,
  1130	      });
  1131	    } catch {
  1132	      /* the store is what failed; the run history still records it */
  1133	    }
