   571	function handoffEnvelope(handoff: HandoffRecord): string {
   572	  const lines = [
   573	    `Handoff from ${handoff.sourceName}.`,
   574	    handoff.groupName ? `This belongs to the group chat ${handoff.groupName}.` : "This arrives in your own chat.",
   575	    "Do the work and answer here. Your reply is returned to the sender and the owner reads both transcripts.",
   576	    ...(handoff.depth > 0 ? [`This is relay hop ${handoff.depth} of at most ${HANDOFF_DEPTH_MAX}.`] : []),
   577	    "",
   578	    handoff.message,
   579	  ];
   580	  return lines.join("\n");
