   124	  // not, and a prefix test refuses it for no reason.
   125	  if (rel === ".." || rel.startsWith("../") || rel.startsWith("..\\") || isAbsolute(rel)) {
   126	    throw new Error("path_escape");
   127	  }
   128	  // Only the part under the root is screened. The root itself is a folder the
   129	  // owner picked (or configured) by name, so a project that happens to live in
   130	  // a path containing one of these words stays reachable; anything inside it
   131	  // — a `.env`, a `.git/config`, a `secrets/` directory — is still refused.
   132	  const loweredRel = rel.toLowerCase();
   133	  for (const part of FORBIDDEN_PATH_SUBSTRINGS) {
   134	    if (loweredRel.includes(part.toLowerCase())) {
   135	      throw new Error("path_forbidden");
   136	    }
   137	  }
   138	  // Exact segment names, so a credential store is refused without `.docker`
   139	  // also refusing the `.dockerignore` next to it.
   140	  for (const segment of loweredRel.split(/[/\\]/)) {
