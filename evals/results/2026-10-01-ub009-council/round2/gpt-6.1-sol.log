   238	      previous = null;
   239	    }
   240	    const next = mutate(previous ?? seedStore());
   241	    writeStoreFile(next, path);
   242	    return next;
   243	  } finally {
   244	    try { rmdirSync(lock); } catch { /* ignore */ }
   245	  }
