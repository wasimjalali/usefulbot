   126	export function buildMessagesBody(
   127	  chatBody: Record<string, unknown>,
   128	  opts: { model: string; cache?: boolean },
   129	): Record<string, unknown> {
   130	  if (!Array.isArray(chatBody.messages)) throw protocolError();
   131	  if (typeof chatBody.max_tokens !== "number") throw protocolError();
   132	  const systemParts: string[] = [];
   133	  const messages: Array<Record<string, unknown>> = [];
   134	  let toolResults: Array<Record<string, unknown>> = [];
   135	  const flushTools = () => {
   136	    if (toolResults.length > 0) {
   137	      pushUser(messages, toolResults);
   138	      toolResults = [];
   139	    }
   140	  };
   141	  for (const item of chatBody.messages) {
   142	    if (!isRecord(item) || typeof item.role !== "string") throw protocolError();
   143	    if (item.role === "system") {
   144	      const text = contentString(item.content);
   145	      if (text) systemParts.push(text);
   146	      continue;
   147	    }
   148	    if (item.role === "tool") {
   149	      if (typeof item.tool_call_id !== "string") throw protocolError();
   150	      toolResults.push({ type: "tool_result", tool_use_id: safeToolId(item.tool_call_id), content: contentString(item.content) });
   151	      continue;
   152	    }
   153	    flushTools();
   154	    if (item.role === "assistant" && Array.isArray(item.tool_calls)) {
   155	      const content: Array<Record<string, unknown>> = [];
   156	      const text = contentString(item.content);
   157	      if (text.trim()) content.push({ type: "text", text });
   158	      for (const call of item.tool_calls) {
   159	        if (!isRecord(call) || typeof call.id !== "string" || !isRecord(call.function) || typeof call.function.name !== "string") {
   160	          throw protocolError();
   161	        }
   162	        content.push({ type: "tool_use", id: safeToolId(call.id), name: call.function.name, input: toolInput(call.function.arguments) });
   163	      }
   164	      // Messages refuses an assistant turn with no content at all.
   165	      if (content.length > 0) messages.push({ role: "assistant", content });
   166	      continue;
   167	    }
   168	    if (Array.isArray(item.content)) {
   169	      if (item.role !== "user") throw protocolError();
   170	      pushUser(messages, toAnthropicContent(item.content));
   171	    } else if (item.role === "user") {
   172	      pushUser(messages, [{ type: "text", text: contentString(item.content) }]);
   173	    } else if (item.role === "assistant") {
   174	      // Empty (or blank) assistant turns, left by a model that answered with
   175	      // nothing, are a 400 on Messages: drop them.
   176	      const text = contentString(item.content);
   177	      if (text.trim()) messages.push({ role: "assistant", content: text });
   178	    } else {
   179	      throw protocolError();
   180	    }
   181	  }
   182	  flushTools();
