    21	 *
    22	 * Exposes read-only session identity, auth, and channel metadata. State
    23	 * is not exposed here; resolvers read it through `defineState` handles or
    24	 * the session context inside tool `execute` functions.
    25	 */
    26	export interface DynamicResolveContext {
    27	    readonly session: {
    28	        readonly id: string;
    29	        readonly auth: SessionAuth;
    30	    };
    31	    /** Channel metadata for the request that triggered this resolve. */
    32	    readonly channel: {
    33	        /** Channel type that produced the request (e.g. `"slack"`, `"http"`), when known. */
    34	        readonly kind?: string;
    35	        /** Channel-owned resume handle for the conversation, when the channel supplies one. */
    36	        readonly continuationToken?: string;
    37	        /** Free-form channel-specific metadata attached to the request. */
    38	        readonly metadata?: Readonly<Record<string, unknown>>;
    39	    };
    40	    /** Conversation history visible at this resolve point, oldest first. */
    41	    readonly messages: readonly ModelMessage[];
    42	}
    43	/**
    44	 * Base event handler map accepted by `defineDynamic`. Intentionally
    45	 * wide so it accepts both tool-returning and skill-returning handlers:
    46	 * the slot directory (tools/ vs skills/) determines the required return,
    47	 * validated at runtime by the respective resolver.
    48	 */
    49	export type DynamicEvents<TResult = unknown> = {
    50	    readonly [K in DynamicToolEventName]?: (event: unknown, ctx: DynamicResolveContext) => TResult | Promise<TResult>;
    51	};
    52	type DynamicEventMapHandler<TEvents extends DynamicEvents> = Extract<NonNullable<TEvents[keyof TEvents]>, (...args: never[]) => unknown>;
    53	type DynamicEventMapResult<TEvents extends DynamicEvents> = Awaited<ReturnType<DynamicEventMapHandler<TEvents>>>;
    54	/**
    55	 * Marker discriminator for a `defineDynamic({ events })` export.
    56	 */
    57	export declare const DYNAMIC_SENTINEL_KIND: "eve:dynamic";
    58	/**
    59	 * Return value of `defineDynamic`: the runtime shape of a dynamic export,
    60	 * stamped with a sentinel kind the compiler/normalizer detects.
    61	 */
    62	export type DynamicSentinel<TResult = unknown> = {
    63	    readonly kind: typeof DYNAMIC_SENTINEL_KIND;
    64	    readonly events: DynamicEvents<TResult>;
    65	};
