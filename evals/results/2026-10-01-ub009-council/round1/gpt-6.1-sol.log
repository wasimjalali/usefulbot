   340	  read(id: string, audience: Audience): MemoryExcerpt {
   341	    assertNoteId(id);
   342	    const path = join(this.notesDir, `${id}.md`);
   343	    if (!existsSync(path)) {
   344	      throw new Error("memory_not_found");
   345	    }
   346	    const { meta, body } = parseNote(readFileSync(path, "utf8"));
   347	    if (meta.audience !== audience || meta.status !== "active") {
   348	      throw new Error("memory_forbidden");
   349	    }
   350	    const clipped = body.slice(0, 1024);
   351	    return {
   352	      id: meta.id,
   353	      revision: meta.revision,
   354	      title: meta.title,
   355	      body: clipped,
   356	      truncated: body.length > 1024,
   357	    };
   358	  }
